model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-AS
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["AI_Impact_Raw","Skills","Measurestbl","model_metrics"]

annotation PBI_ProTooling = ["DevMode"]

ref table AI_Impact_Raw
ref table Skills
ref table Measurestbl
ref table model_metrics

ref cultureInfo en-US

